8e82e2592d78"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mu", "  ", "=", " ", "18"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Central", " ", "value", " ", "of", " ", "the", " ", "Radii", " ", 
    "Distribution"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigma", " ", "=", "1.1"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Standard", " ", "deviation", " ", "from", " ", "Raddii", " ", 
    "Distribution"}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Upper", " ", "and", " ", "lower", " ", "integration", " ", "limits", " ", 
    "fo", " ", "the", " ", "polydispersed", " ", "case"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"rhost", " ", "=", " ", 
  RowBox[{"cfrac", " ", "*", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "2"}], "*", 
      RowBox[{
       RowBox[{"Log", "[", "sigma", "]"}], "^", "2"}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"Pi", " ", "*", " ", 
      RowBox[{"mu", "^", "2"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sizeDist", " ", "=", " ", 
   RowBox[{
    RowBox[{"rhost", " ", "*", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"#", "/", "#2"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", "2.", "]"}], "*", 
             RowBox[{"Log", "[", "#3", "]"}]}], ")"}]}], ")"}], "^", "2"}]}], 
       "]"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"#", "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"2.", "*", "Pi"}], "]"}], "*", 
        RowBox[{"Log", "[", "#3", "]"}]}], ")"}]}]}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"sizeDist", "[", 
    RowBox[{"x", ",", "mu", ",", "sigma"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"mu", "*", 
      RowBox[{"sigma", "^", 
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", "18.", "]"}]}], ")"}]}]}], ",", 
     RowBox[{"mu", "*", 
      RowBox[{"sigma", "^", 
       RowBox[{"(", 
        RowBox[{"Sqrt", "[", "18.", "]"}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], 
  "]"}], "\n", "sizeDist"}], "Code",
