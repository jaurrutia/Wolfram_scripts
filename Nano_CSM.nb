Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mu", "  ", "=", " ", "30"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Central", " ", "value", " ", "of", " ", "the", " ", "Radii", " ", 
    "Distribution"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigma", " ", "=", "1.1"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Standard", " ", "deviation", " ", "from", " ", "Raddii", " ", 
    "Distribution"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"rhost", " ", "=", " ", 
   RowBox[{"cfrac", " ", "*", " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       RowBox[{
        RowBox[{"Log", "[", "sigma", "]"}], "^", "2"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"Pi", " ", "*", " ", 
       RowBox[{"mu", "^", "2"}]}], ")"}]}]}]}], 
  RowBox[{"(*", 
   RowBox[{"??", " ", 
    RowBox[{"No", " ", "hay", " ", "que", " ", "cambiarlo", "??"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sizeDist", " ", "=", " ", 
   RowBox[{
    RowBox[{"rhost", " ", "*", " ", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"mu", ",", "sigma"}], "]"}], ",", "#"}], "]"}]}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"sizeDist", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"mu", "*", 
      RowBox[{"sigma", "^", 
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", "18.", "]"}]}], ")"}]}]}], ",", 
     RowBox[{"mu", "*", 
      RowBox[{"sigma", "^", 
       RowBox[{"(", 
        RowBox[{"Sqrt", "[", "18.", "]"}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Code",
