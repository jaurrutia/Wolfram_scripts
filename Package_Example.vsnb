  },
  {
   "kind": 2,
   "value": "modulus = 2^31 - 1;\nseed = 1;\n\nLCGSetSeed[x_Integer /; 1 <= seed < modulus] := seed = x\nLCGRandom[] := (\n    seed = Mod[7^5 * seed, modulus];\n    N[seed/modulus]\n)\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
