  {
   "kind": 2,
   "value": "LCGSetSeed::usage = \"LCGSetSeed[x] sets the LCG random number generator's seed to the integer x.\";\nLCGRandom::usage = \"LCGRandom[] generates a uniformly distributed random in te range {0.,1.} using a linear congruential generator.\"",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "LCGRandom[] generates a uniformly distributed random in te range {0.,1.} using a linear congruential generator.",
